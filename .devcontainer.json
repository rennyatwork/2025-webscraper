{
    "name": "Python 3.12 Development Container",
    "dockerFile": "Dockerfile",  // or specify the path to your Dockerfile
    "context": ".",
    "runArgs": [
        "--expose=5678"
    ],
    "postCreateCommand": "pip install -r requirements.txt",  // Run this after container setup
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-azuretools.vscode-docker",
                "ms-vscode-remote.remote-containers"
            ]
        }
    }
}
