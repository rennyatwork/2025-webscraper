# Base image for Scrapy
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install necessary dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Scrapy spider files
COPY . .

# Expose the API port
EXPOSE 8000

# Start the FastAPI service (scrapy_api.py should be inside the scrapy directory)
CMD ["uvicorn", "scrapy.scrapy_api:app", "--host", "0.0.0.0", "--port", "8000"]
